# SDLC Auto -- Docker Compose deployment mode (master spec §14.16).
#
# Copy this file to `.env` (gitignored) and fill in real values. Per
# §17.4 ("Local Secret Handling for the Docker Compose Deployment
# Mode"): this mode holds the small, fixed set of secrets a single
# deployment needs in a local file read directly by the one deployment
# that needs it, rather than the per-tenant KMS-wrapped Secrets Manager
# §17.3 specifies for the multi-tenant cloud architecture -- an accepted
# reduction in isolation strength for the single-tenant case, not a
# substitute for §17.3 in any deployment serving more than one tenant.
#
# NEVER commit a filled-in `.env` -- only this example, with no real
# values, belongs in git (see repo-root .gitignore).

# ---------------------------------------------------------------------
# Tenancy (§14.16: single-tenant by construction -- one fixed tenant_id,
# not resolved per request)
# ---------------------------------------------------------------------
TENANT_ID=tenant-acme

# ---------------------------------------------------------------------
# GitHub App (source-control, D5) -- §17.1: a GitHub App installation,
# never a personal access token. See services/source-control/SETUP.md
# for how to register the App and obtain these values.
# ---------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Path to the App's private key .pem, bind-mounted read-only into
# whatever container needs it (see docker-compose.yml) -- never paste
# the key's contents directly into this file.
GITHUB_APP_PRIVATE_KEY_PATH=./deploy/secrets/github-app-private-key.pem
# HMAC secret GitHub signs its webhook deliveries with (§17.3-style
# verification at the source-control boundary).
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Jira (issue-tracker D4 / job-dispatcher D1) -- §4.4's trigger design,
# §17.3's per-tenant webhook HMAC scheme. See
# services/issue-tracker/SETUP.md for the Jira Automation rule this
# pairs with.
# ---------------------------------------------------------------------
JIRA_PROJECT_KEY=PROJ
# The per-tenant HMAC key job-dispatcher verifies every inbound webhook
# against *before* anything else runs (services/job-dispatcher's
# webhook_auth.py). Generate a long random value; it never appears in
# any committed file.
JIRA_WEBHOOK_SECRET=
JIRA_BASE_URL=https://your-site.atlassian.net
# "oauth_bearer" (Atlassian Rovo/Connect OAuth) or "basic" (email + API
# token) -- see services/issue-tracker/src/issue_tracker/config.py.
JIRA_AUTH_MODE=oauth_bearer
JIRA_OAUTH_BEARER_TOKEN=
JIRA_BASIC_AUTH_EMAIL=
JIRA_BASIC_AUTH_API_TOKEN=
JIRA_OPT_IN_LABEL=ai-factory
JIRA_TRIGGER_STATUS=Selected for Development
JIRA_APPROVAL_STATUS=In Progress
JIRA_CHANGE_REVIEW_STATUS=In Review
# (New) Where a story lands once its run finishes successfully (a real
# PR opened) -- the fourth org-specific status name, alongside the
# three above. Never applied on an abandoned/rejected run -- that stays
# in JIRA_APPROVAL_STATUS instead, needing a human look (see
# deploy/run-worker/jira_poll_run.py).
JIRA_DONE_STATUS=Done
JIRA_SIZE_FIELD_MODE=label
JIRA_EPIC_LINK_MODE=parent

# ---------------------------------------------------------------------
# Model inference vendor (orchestrator D2, §13.8: "Multi-Vendor
# API-Key Inference") -- pick ONE vendor by setting
# ORCHESTRATOR_INFERENCE_VENDOR and filling in only that vendor's
# section below. Field names match create_agent_backend(...)'s kwargs
# verbatim (services/orchestrator/README.md "Selecting an inference
# vendor"). NOTE (see that README and this repo's own report on this
# deliverable): orchestrator has no standalone process/CLI in this
# codebase today that reads these variables at startup -- they are set
# here as the config surface a future orchestrator entrypoint (or
# whatever wires create_agent_backend(...) at process start) will
# consume without any docker-compose.yml change, per this deployment
# mode's "config, not code" requirement for vendor selection.
# ---------------------------------------------------------------------
ORCHESTRATOR_INFERENCE_VENDOR=anthropic

# vendor: anthropic
ANTHROPIC_API_KEY=

# vendor: openai
OPENAI_API_KEY=

# vendor: bedrock (Amazon Bedrock, hosting MiniMax M2.5 among others --
# model_id has no default, see services/orchestrator's
# bedrock_backend.py docstring for why). Confirmed real, ACTIVE,
# ON_DEMAND-capable model id via `aws bedrock get-foundation-model`:
# minimax.minimax-m2.5 (also available: minimax.minimax-m2,
# minimax.minimax-m2.1 -- m2.5 is the latest of the three).
BEDROCK_MODEL_ID=minimax.minimax-m2.5
AWS_REGION=us-east-1
# Two mutually exclusive ways to authenticate -- set ONE:
#   (a) AWS_BEARER_TOKEN_BEDROCK: a Bedrock API key (AWS's own newer,
#       simpler auth mechanism, https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html)
#       -- boto3 recognizes this env var automatically, no other AWS
#       credential needed. This is what a Bedrock console-generated
#       "long-term API key" is for -- set here, nothing else to fill in.
#   (b) AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN:
#       ordinary IAM credentials (SigV4), the multi-tenant cloud
#       architecture's own auth mechanism -- use these instead if you'd
#       rather not generate a separate Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# vendor: ollama (self-hosted -- the multi-tenant cloud architecture's
# own option; included here for completeness, not this mode's
# recommended path since §13.8 exists precisely because this mode has
# no GPU to self-host on)
OLLAMA_BASE_URL=http://ollama:11434

# ---------------------------------------------------------------------
# Reverse proxy / TLS (Caddy, deploy/caddy/Caddyfile)
# ---------------------------------------------------------------------
# Local/eval use: leave as "localhost" -- Caddy mints its own local CA
# and a self-signed certificate off it automatically ("tls internal" in
# the Caddyfile).
# Real deployment: set this to a real, DNS-resolvable hostname pointing
# at this host, set CADDY_ACME_EMAIL, and remove "tls internal" from
# deploy/caddy/Caddyfile -- Caddy then obtains/renews a real Let's
# Encrypt certificate automatically.
CADDY_DOMAIN=localhost
CADDY_ACME_EMAIL=

# ---------------------------------------------------------------------
# Ports (rarely need changing; the reverse proxy is the only thing
# meant to be reachable from outside this host -- see README)
# ---------------------------------------------------------------------
JOB_DISPATCHER_PORT=8809
FLEET_DASHBOARD_PORT=8808

# job-dispatcher's capacity provider (New, Rev 9): "local" (default for
# this deployment mode) is always-available, no GPU to provision --
# correct here since inference is delegated to an external API-key
# vendor above (Sec. 13.8), not self-hosted. Leave as "local" unless you
# know you want "mock" (the multi-tenant cloud architecture's dev/test
# provider) instead.
JOB_DISPATCHER_CAPACITY_PROVIDER=local

# ---------------------------------------------------------------------
# Optional observability profile (`docker compose --profile
# observability up` -- see docker-compose.yml). Unused unless that
# profile is started.
# ---------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
