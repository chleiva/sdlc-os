# --- Internal specification & planning docs -------------------------------
# The System this repo builds is open-source per its own spec (Apache-2.0,
# see LICENSE). The *internal* specification, architecture rationale, and
# deliverable-decomposition docs that describe it are not for the public
# repo — they stay local only. See CLAUDE.md for where these actually live.
docs/

# --- OS / editor cruft ------------------------------------------------------
.DS_Store

# --- D14: Docker Compose deployment mode local secrets (§17.4) -------------
# `.env` holds real secret values a deployer fills in from `.env.example`;
# never committed. `deploy/secrets/` is this mode's local-secret-file
# mount point (e.g. the GitHub App private key) -- never committed either.
.env
deploy/secrets/

# --- Claude Code local-only state ------------------------------------------
.claude/settings.local.json
.claude/hooks/

# --- Python -----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# --- OpenTofu / Terraform ----------------------------------------------------
# State and local provider caches can hold secrets/resource IDs and are huge —
# never belong in a public repo regardless of the auto-commit hook's reach.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*tfplan*
.terraformrc
terraform.rc
