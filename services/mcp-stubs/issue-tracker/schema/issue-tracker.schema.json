{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-auto.internal/schemas/mcp/issue-tracker/1.0.0",
  "title": "Issue-Tracker (Jira) MCP Server -- Tool Contracts",
  "server": "issue-tracker",
  "version": "1.0.0",
  "description": "Scoped to the tenant's own configured Jira projects. Jira is the blackboard of record (spec Sec. 4.4): plans, verification reports, and gate transitions all round-trip through this server.",
  "tenant_scoping": "may be a single shared, tenant-scoped multi-tenant deployment (spec Sec. 7.6/14.13) -- never holds tenant source code or execution credentials",
  "contract_shape": "Every tool below follows the same contract shape (spec Sec. 7.6): typed required/optional inputs, a success result shape, a distinct empty result shape, and named error conditions (not-found, permission-denied, rate-limited, upstream-unavailable) that can never be confused with a successful empty result. Every input schema and output schema on this page is JSON Schema 2020-12 (spec Sec. 7.5).",
  "tools": {
    "create-epic": {
      "summary": "Write a new Epic with the fields Sec. 4.4 specifies (sizing label, dependency links).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "",
        "required": [
          "tenant_id",
          "project_key",
          "summary",
          "description",
          "acceptance_criteria"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Tenant identifier that scopes this request. First-class on every request across every MCP server in this system (spec Sec. 14.13); enforced fail-closed at the server -- a request with no tenant_id, or one the caller's credential is not authorized for, is rejected as permission-denied rather than silently defaulting to any tenant or falling back to a single-tenant assumption."
          },
          "project_key": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "size": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L",
              "XL"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "title": "SuccessResult",
            "description": "",
            "required": [
              "outcome",
              "data"
            ],
            "properties": {
              "outcome": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "required": [
                  "issue_key",
                  "url"
                ],
                "properties": {
                  "issue_key": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$",
                    "description": "Jira-style issue key, e.g. PROJ-123."
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "An epic with the same summary already exists in this project -- treated as an idempotent no-op, no duplicate created.",
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable, caller-safe explanation of why nothing matched. Never null, never absent."
              },
              "existing_issue_key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$",
                "description": "Jira-style issue key, e.g. PROJ-123."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "ErrorResult",
            "description": "A named, structured error condition. Always carries a non-null 'error' object -- this is what makes it impossible to confuse with EmptyResult, which never carries one.",
            "required": [
              "outcome",
              "error"
            ],
            "properties": {
              "outcome": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not-found",
                      "permission-denied",
                      "rate-limited",
                      "upstream-unavailable"
                    ],
                    "description": "The four named error conditions every MCP tool contract in this system carries (spec Sec. 7.6)."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean",
                    "description": "True for rate-limited and upstream-unavailable; false for not-found and permission-denied."
                  },
                  "retry_after_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Populated for rate-limited; null otherwise."
                  },
                  "details": {
                    "type": "object",
                    "description": "Free-form structured context (e.g. which upstream, which quota). Not required."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "create-story": {
      "summary": "Write a new Story under a parent Epic, sized (S/M/L/XL), with dependency links as native issue links.",
      "input_schema": {
