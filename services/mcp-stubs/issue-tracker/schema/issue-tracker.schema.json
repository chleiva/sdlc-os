                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "epic_key": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$",
                    "description": "Jira-style issue key, e.g. PROJ-123."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "A story with the same summary already exists under this epic -- idempotent no-op, no duplicate created.",
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
