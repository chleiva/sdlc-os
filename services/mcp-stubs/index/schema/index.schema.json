{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-auto.internal/schemas/mcp/index/1.0.0",
  "title": "Repository Index MCP Server -- Tool Contracts",
  "server": "index",
  "version": "1.0.0",
  "description": "Read-only index server, scoped to the tenant's own repositories only (spec Sec. 8.6). Deterministic symbol/dependency graph first (Sec. 6.2); the search tool is the sole semantic/embedding-backed exception and is explicitly non-authoritative.",
  "tenant_scoping": "per-tenant deployment (touches tenant source code, spec Sec. 14.13)",
  "contract_shape": "Every tool below follows the same contract shape (spec Sec. 7.6): typed required/optional inputs, a success result shape, a distinct empty result shape, and named error conditions (not-found, permission-denied, rate-limited, upstream-unavailable) that can never be confused with a successful empty result. Every input schema and output schema on this page is JSON Schema 2020-12 (spec Sec. 7.5).",
  "tools": {
    "find-definition": {
      "summary": "Given a symbol and an origin location, return its exact definition site(s).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Find the definition site(s) of a symbol referenced from a known origin location.",
        "required": [
          "tenant_id",
          "repository",
          "symbol",
          "origin"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Tenant identifier that scopes this request. First-class on every request across every MCP server in this system (spec Sec. 14.13); enforced fail-closed at the server -- a request with no tenant_id, or one the caller's credential is not authorized for, is rejected as permission-denied rather than silently defaulting to any tenant or falling back to a single-tenant assumption."
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object",
            "description": "Location the symbol was referenced from, used to disambiguate same-named symbols.",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "title": "SuccessResult",
            "description": "One or more definition sites (more than one for e.g. overloads).",
            "required": [
              "outcome",
              "data"
            ],
            "properties": {
              "outcome": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "required": [
                  "definitions"
                ],
                "properties": {
                  "definitions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "file",
                        "line",
                        "symbol",
                        "kind"
                      ],
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "column": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "symbol": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "function",
                            "method",
                            "class",
                            "interface",
                            "variable",
                            "constant",
                            "type",
                            "module"
                          ]
                        },
                        "snippet": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "No definition site was found for this symbol from the given origin.",
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable, caller-safe explanation of why nothing matched. Never null, never absent."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "ErrorResult",
            "description": "A named, structured error condition. Always carries a non-null 'error' object -- this is what makes it impossible to confuse with EmptyResult, which never carries one.",
            "required": [
              "outcome",
              "error"
            ],
            "properties": {
              "outcome": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not-found",
                      "permission-denied",
                      "rate-limited",
                      "upstream-unavailable"
                    ],
                    "description": "The four named error conditions every MCP tool contract in this system carries (spec Sec. 7.6)."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean",
                    "description": "True for rate-limited and upstream-unavailable; false for not-found and permission-denied."
                  },
                  "retry_after_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Populated for rate-limited; null otherwise."
                  },
                  "details": {
                    "type": "object",
                    "description": "Free-form structured context (e.g. which upstream, which quota). Not required."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "find-references": {
      "summary": "Given a symbol, return every reference across the full index -- exhaustive, never sampled (spec Sec. 6.6).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Exhaustive reference search. The exhaustive:true flag on the result is a literal contract guarantee, not a hint -- this operation is never sampled.",
        "required": [
          "tenant_id",
          "repository",
          "symbol"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Tenant identifier that scopes this request. First-class on every request across every MCP server in this system (spec Sec. 14.13); enforced fail-closed at the server -- a request with no tenant_id, or one the caller's credential is not authorized for, is rejected as permission-denied rather than silently defaulting to any tenant or falling back to a single-tenant assumption."
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object",
            "description": "Location the symbol was referenced from, used to disambiguate same-named symbols.",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "include_test_files": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "title": "SuccessResult",
            "description": "",
            "required": [
              "outcome",
              "data"
            ],
            "properties": {
              "outcome": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "required": [
                  "references",
                  "total_count",
                  "exhaustive"
                ],
                "properties": {
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "file",
                        "line",
                        "context_snippet"
                      ],
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "column": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "context_snippet": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "total_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "exhaustive": {
                    "const": true,
                    "description": "Always true. This search covers the full index, including packages/services outside any declared plan scope -- never a similarity sample."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "The symbol has zero references anywhere in the index. The exhaustive scan still ran to completion -- this is a confirmed zero, not a skipped search.",
            "required": [
              "outcome",
              "reason",
              "exhaustive"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable, caller-safe explanation of why nothing matched. Never null, never absent."
              },
              "exhaustive": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "ErrorResult",
            "description": "A named, structured error condition. Always carries a non-null 'error' object -- this is what makes it impossible to confuse with EmptyResult, which never carries one.",
            "required": [
              "outcome",
              "error"
            ],
            "properties": {
              "outcome": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not-found",
                      "permission-denied",
                      "rate-limited",
                      "upstream-unavailable"
                    ],
                    "description": "The four named error conditions every MCP tool contract in this system carries (spec Sec. 7.6)."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean",
                    "description": "True for rate-limited and upstream-unavailable; false for not-found and permission-denied."
                  },
                  "retry_after_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Populated for rate-limited; null otherwise."
                  },
                  "details": {
                    "type": "object",
                    "description": "Free-form structured context (e.g. which upstream, which quota). Not required."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "find-callers": {
      "summary": "Given a function/method, return its call sites and their containing symbols, one graph hop at a time.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Returns direct callers only (one hop); call again on a returned caller symbol to walk the graph further.",
        "required": [
          "tenant_id",
          "repository",
          "symbol"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Tenant identifier that scopes this request. First-class on every request across every MCP server in this system (spec Sec. 14.13); enforced fail-closed at the server -- a request with no tenant_id, or one the caller's credential is not authorized for, is rejected as permission-denied rather than silently defaulting to any tenant or falling back to a single-tenant assumption."
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object",
            "description": "Location the symbol was referenced from, used to disambiguate same-named symbols.",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor from a previous call's result."
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "title": "SuccessResult",
            "description": "",
            "required": [
              "outcome",
              "data"
            ],
            "properties": {
              "outcome": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "required": [
                  "hop",
                  "callers"
                ],
                "properties": {
                  "hop": {
                    "const": 1
                  },
                  "callers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "file",
                        "line",
                        "call_site_symbol",
                        "containing_symbol"
                      ],
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "call_site_symbol": {
                          "type": "string"
                        },
                        "containing_symbol": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "next_cursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "The function/method has no callers anywhere in the index (dead code, or an entry point).",
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable, caller-safe explanation of why nothing matched. Never null, never absent."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "ErrorResult",
            "description": "A named, structured error condition. Always carries a non-null 'error' object -- this is what makes it impossible to confuse with EmptyResult, which never carries one.",
            "required": [
              "outcome",
              "error"
            ],
            "properties": {
              "outcome": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not-found",
                      "permission-denied",
                      "rate-limited",
                      "upstream-unavailable"
                    ],
                    "description": "The four named error conditions every MCP tool contract in this system carries (spec Sec. 7.6)."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean",
                    "description": "True for rate-limited and upstream-unavailable; false for not-found and permission-denied."
                  },
                  "retry_after_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Populated for rate-limited; null otherwise."
                  },
                  "details": {
                    "type": "object",
                    "description": "Free-form structured context (e.g. which upstream, which quota). Not required."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "search": {
      "summary": "Semantic/natural-language search over files, functions, and docs -- discovery only.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Ranked, natural-language discovery. Never authoritative for impact analysis (spec Sec. 6.2/6.3) -- see the authoritative:false flag on the result.",
        "required": [
          "tenant_id",
          "query"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Tenant identifier that scopes this request. First-class on every request across every MCP server in this system (spec Sec. 14.13); enforced fail-closed at the server -- a request with no tenant_id, or one the caller's credential is not authorized for, is rejected as permission-denied rather than silently defaulting to any tenant or falling back to a single-tenant assumption."
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "description": "Restrict to one repository; omitted searches every repository this tenant has indexed."
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "title": "SuccessResult",
            "description": "",
            "required": [
              "outcome",
              "data"
            ],
            "properties": {
              "outcome": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "required": [
                  "results",
                  "authoritative",
                  "label"
                ],
                "properties": {
                  "results": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "file",
                        "score"
                      ],
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "symbol": {
                          "type": "string"
                        },
                        "score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "snippet": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "authoritative": {
                    "const": false,
                    "description": "Always false. This is a ranked candidate list for discovery, never a substitute for find-references."
                  },
                  "label": {
                    "const": "non-authoritative"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "No candidates matched the query well enough to return.",
            "required": [
              "outcome",
              "reason",
              "authoritative",
              "label"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable, caller-safe explanation of why nothing matched. Never null, never absent."
              },
              "authoritative": {
                "const": false
              },
              "label": {
                "const": "non-authoritative"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "ErrorResult",
            "description": "A named, structured error condition. Always carries a non-null 'error' object -- this is what makes it impossible to confuse with EmptyResult, which never carries one.",
            "required": [
              "outcome",
              "error"
            ],
            "properties": {
              "outcome": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not-found",
                      "permission-denied",
                      "rate-limited",
                      "upstream-unavailable"
                    ],
                    "description": "The four named error conditions every MCP tool contract in this system carries (spec Sec. 7.6)."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean",
                    "description": "True for rate-limited and upstream-unavailable; false for not-found and permission-denied."
                  },
                  "retry_after_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Populated for rate-limited; null otherwise."
                  },
                  "details": {
                    "type": "object",
                    "description": "Free-form structured context (e.g. which upstream, which quota). Not required."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "get-file-module-summary": {
      "summary": "Return a generated summary for a large or generated file/module rather than its full contents.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "description": "Summarization, not retrieval -- use get-file-contents (source-control server) for full contents of a file the caller has decided it must fully read.",
        "required": [
          "tenant_id",
          "repository",
          "path"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Tenant identifier that scopes this request. First-class on every request across every MCP server in this system (spec Sec. 14.13); enforced fail-closed at the server -- a request with no tenant_id, or one the caller's credential is not authorized for, is rejected as permission-denied rather than silently defaulting to any tenant or falling back to a single-tenant assumption."
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "title": "SuccessResult",
            "description": "",
            "required": [
              "outcome",
              "data"
            ],
            "properties": {
              "outcome": {
                "const": "ok"
              },
              "data": {
                "type": "object",
                "required": [
                  "path",
                  "summary",
                  "symbol_count",
                  "generated"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbol_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "generated": {
                    "type": "boolean",
                    "description": "Whether this file is itself machine-generated (e.g. protobuf output, a lockfile)."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "EmptyResult",
            "description": "The file exists and is indexed, but is empty (zero bytes) -- there is nothing to summarize.",
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "const": "empty"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable, caller-safe explanation of why nothing matched. Never null, never absent."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "ErrorResult",
            "description": "A named, structured error condition. Always carries a non-null 'error' object -- this is what makes it impossible to confuse with EmptyResult, which never carries one.",
            "required": [
              "outcome",
              "error"
            ],
            "properties": {
              "outcome": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
