                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not-found",
                      "permission-denied",
                      "rate-limited",
                      "upstream-unavailable"
                    ],
                    "description": "The four named error conditions every MCP tool contract in this system carries (spec Sec. 7.6)."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean",
                    "description": "True for rate-limited and upstream-unavailable; false for not-found and permission-denied."
                  },
                  "retry_after_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Populated for rate-limited; null otherwise."
                  },
                  "details": {
                    "type": "object",
                    "description": "Free-form structured context (e.g. which upstream, which quota). Not required."
                  }
                },
