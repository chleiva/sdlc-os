              "data": {
                "type": "object",
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "path",
                        "type",
                        "size"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "file",
                            "directory"
                          ]
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "next_cursor": {
                    "type": [
                      "string",
