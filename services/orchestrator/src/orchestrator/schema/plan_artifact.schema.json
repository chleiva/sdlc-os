{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-auto.example/schemas/plan-artifact.schema.json",
  "title": "Structured Plan Artifact",
  "description": "Master spec Section 9.5's machine-checkable shadow of the human-readable plan document. Regenerated (never hand-edited) whenever the human-readable plan changes at a Section 9.2 gate.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "plan_version",
    "generated_at",
    "source_plan_hash",
    "declared_scope",
    "acceptance_criteria_map",
    "subtask_graph",
    "risk"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source_plan_hash": {
      "type": "string",
      "minLength": 1,
      "description": "Content hash of the human-readable plan this artifact was generated from -- ties the two together and lets a caller detect the human plan changed underneath a stale artifact."
    },
    "declared_scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope"],
      "additionalProperties": false,
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance_criteria_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "description", "verification_tests"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "verification_tests": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "description": "Section 9.5: each acceptance criterion paired with the specific new/updated test(s) that demonstrate it, populated before implementation starts."
          }
        }
      }
    },
    "subtask_graph": {
      "type": "object",
      "required": ["subtasks"],
      "additionalProperties": false,
      "properties": {
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task_id", "description", "mode"],
            "additionalProperties": false,
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "enum": ["parallel", "sequential"]},
              "parallel_group": {"type": ["string", "null"]},
              "depends_on": {"type": "array", "items": {"type": "string"}},
              "interface_contract": {
                "type": ["string", "null"],
                "description": "Section 8.1 'contracts before parallel writes': required (non-null) for any subtask whose parallel_group is shared with another subtask."
              }
            }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["tier", "cross_cutting_or_high_risk", "story_size", "budget"],
      "additionalProperties": false,
      "properties": {
        "tier": {"type": "string", "enum": ["low", "medium", "high"]},
        "cross_cutting_or_high_risk": {"type": "boolean"},
        "story_size": {"type": "string", "enum": ["S", "M", "L", "XL"]},
        "budget": {
          "type": "object",
          "required": [
            "wall_clock_minutes",
            "cost_ceiling_usd",
            "size_checkpoint_lines",
            "size_checkpoint_files"
          ],
          "additionalProperties": false,
          "properties": {
            "wall_clock_minutes": {"type": "number", "minimum": 0},
            "cost_ceiling_usd": {"type": "number", "minimum": 0},
            "size_checkpoint_lines": {"type": "integer", "minimum": 0},
            "size_checkpoint_files": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
